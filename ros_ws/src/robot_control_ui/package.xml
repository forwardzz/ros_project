<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_control_ui</name>
  <version>0.1.0</version>
  <description>Desktop control UI for the tracked robot.</description>
  <maintainer email="yy@example.com">yy</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>robot_monitor_interfaces</depend>
  <depend>robot_mission_utils</depend>

  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rqt_graph</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python_qt_binding</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
